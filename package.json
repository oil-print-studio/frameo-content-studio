{
  "name": "frameo-content-studio",
  "version": "0.1.0",
  "private": true,
  "description": "FRAME O 운영자용 인스타그램 홍보 콘텐츠 제작 내부 도구",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
