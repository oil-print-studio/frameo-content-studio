# AI 글 생성 provider: "auto" | "anthropic" | "mock"
#  - auto(기본): ANTHROPIC_API_KEY 가 있으면 anthropic, 없으면 mock
AI_PROVIDER=auto

# Anthropic API 키 (없으면 mock 결과로 동작)
ANTHROPIC_API_KEY=

# 사용할 Claude 모델 (선택)
ANTHROPIC_MODEL=claude-opus-5

# ---- 쇼핑 쇼츠 제작기 (/shorts) ----
# Gemini API 키: 있으면 영상 분석·대본·음성에 Gemini 사용, 없으면 로컬 모드(분석·규칙 대본·espeak-ng 테스트 음성)
GEMINI_API_KEY=
# 모델 ID 고정값(기본값은 @google/genai 2.27.0 모델 목록 기준, 실제 호출 검증 전)
# GEMINI_ANALYSIS_MODEL=gemini-3.8-flash
# GEMINI_PLAN_MODEL=gemini-3.8-flash
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# 로컬 도구 위치(PATH 에 없을 때)
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# ESPEAK_PATH=/usr/bin/espeak-ng
# 프로젝트 저장 위치(기본 ./data/shorts)
# SHORTS_DATA_DIR=
